# Copy to backend/.env - never commit .env. SANDBOX credentials only.
TRIPWIRE_MODE=dry            # dry = no network, fake executor | live = PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
ANTHROPIC_API_KEY=           # optional: enables the LLM judge / LLM demo agent
TRIPWIRE_AGENT_API_KEY=      # required; generate a random secret of at least 32 bytes
TRIPWIRE_ADMIN_TOKEN=        # required; use a different random secret of at least 32 bytes
TRIPWIRE_JUDGE_MODEL=claude-sonnet-5-5
# LAKERA_API_KEY=         # optional; known issue: currently escalates every untrusted source, so leave unset
TRIPWIRE_AUDIT_PATH=./audit.jsonl
TRIPWIRE_AUDIT_HMAC_KEY=    # required for a persisted audit log; generate an independent 32+ byte secret
TRIPWIRE_DATABASE_URL=sqlite:///tripwire.db
TRIPWIRE_CORS=http://localhost:5173
